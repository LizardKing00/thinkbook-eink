# thinkbook-eink configuration
# Place this file at /etc/thinkbook-eink/server.toml
#
# Credentials (nextcloud_user/password/token, couchdb_user/password) are
# better placed in /etc/thinkbook-eink/secrets.env instead — see
# secrets.env.example. This file is readable by the plugdev group; that one
# is root-only. Anything set here still works (and wins if set in both
# places), so an existing setup with secrets already in this file doesn't
# break — but new setups should use secrets.env.

# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------

# Rotate the display 180 degrees. Useful if the laptop is mounted upside down
# or the lid display is physically inverted relative to your setup.
# Default: false
#flip = true

# Colour theme. "dark" = dark background with bright text (default).
#                "light" = light background with dark text.
# Default: "dark"
#theme = "light"

# ---------------------------------------------------------------------------
# Networking (eink-server only)
# ---------------------------------------------------------------------------

# Name of the network interface to measure for the upload/download graphs
# (e.g. "eth0", "wlp0s20f3"). By default, eink-server auto-excludes loopback
# and virtual interfaces (docker*, veth*, br-*, virbr*, tun*, tap*) and sums
# whatever real interfaces remain. Set this if you run Docker (bridge/veth
# traffic is symmetric and can otherwise still skew the graphs) and want to
# pin exactly one physical uplink, or if the auto-detection picks up the
# wrong interface on your system. Run `ip -o link show` to list interface
# names.
#network_interface = "wlp0s20f3"

# ---------------------------------------------------------------------------
# Nextcloud (eink-server only)
# ---------------------------------------------------------------------------

# Nextcloud URL (no trailing slash)
#nextcloud_url = "https://localhost"

# Nextcloud admin credentials for version/latency checks.
# Leave empty to skip (online/offline detection still works via status.php).
# Prefer setting these in secrets.env instead (NEXTCLOUD_USER/_PASSWORD) —
# shown here for reference only.
#nextcloud_user = "admin"
#nextcloud_password = "your-password-here"

# Nextcloud app token (recommended over password).
# Generate one in Nextcloud: Settings -> Security -> Devices & sessions.
# When set, nextcloud_password is ignored. Requires nextcloud_user to be set.
# Prefer NEXTCLOUD_TOKEN in secrets.env instead.
#nextcloud_token = "xxxxx-xxxxx-xxxxx-xxxxx-xxxxx"

# Name of the Docker container running Nextcloud (e.g. "nextcloud-aio-nextcloud").
# When set, the "N APP UPDATES PENDING"/"CORE UPDATE PENDING" alerts are
# driven by `occ update:check` run inside that container (checked roughly
# once an hour, not every render) instead of the serverinfo API, which does
# not expose update status on current Nextcloud versions. Requires the
# Docker CLI and permission to use it, same as the "docker" widget.
#nextcloud_container = "nextcloud-aio-nextcloud"

# ---------------------------------------------------------------------------
# Optional service widgets (eink-server only)
# ---------------------------------------------------------------------------

# Widgets shown one at a time in the lower-right panel, rotating every ~5
# minutes. Each entry here is a widget name; a widget only runs (and only
# ever fires requests) if it's listed here. Leave unset/empty and the panel
# shows "NO WIDGETS ENABLED" and nothing else runs.
#
# Available widgets:
#   "docker"   - running/stopped container counts via `docker ps`. Requires
#                the Docker CLI to be installed and the user running
#                eink-server to have permission to use it (member of the
#                `docker` group, or equivalent).
#   "obsidian" - combined disk size / document counts for your Obsidian
#                Self-hosted LiveSync vault database(s), queried directly
#                from CouchDB. Warns once the combined size passes 2GB,
#                since LiveSync keeps full revision history and unbounded
#                growth is easy to miss without a compaction schedule.
#                Requires couchdb_url and couchdb_databases below.
#   "firefly"  - bills paid/unpaid this calendar month from Firefly III's
#                summary API. Requires firefly_url and a Personal Access
#                Token (Options -> Profile -> OAuth -> Personal Access
#                Tokens in Firefly's UI) below.
#enabled_widgets = ["docker", "obsidian", "firefly"]

# CouchDB connection for the "obsidian" widget (no trailing slash).
# Prefer COUCHDB_USER/COUCHDB_PASSWORD in secrets.env instead of the two
# credential lines below — shown here for reference only.
#couchdb_url = "https://obsidian-sync.example.com"
#couchdb_user = "admin"
#couchdb_password = "your-couchdb-password"
# Database name(s) to report on — Self-hosted LiveSync names one database
# per synced vault, so list every vault you want included. Run
# `curl -u user:pass https://your-couchdb-url/_all_dbs` to see what exists
# (ignore "_users" and "_replicator", those are CouchDB's own).
#couchdb_databases = ["obsidian"]

# Firefly III connection for the "firefly" widget (no trailing slash).
# Prefer FIREFLY_TOKEN in secrets.env instead of the line below.
#firefly_url = "https://firefly.example.com"
#firefly_token = "your-personal-access-token"
