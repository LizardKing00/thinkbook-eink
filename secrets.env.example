# thinkbook-eink secrets — eink-server only.
#
# Place the real file at /etc/thinkbook-eink/secrets.env, owned by root
# with permissions restricted to root (chmod 600 — no group/other access,
# unlike server.toml which the plugdev group can read):
#
#   sudo install -m 600 -o root -g root secrets.env.example /etc/thinkbook-eink/secrets.env
#   sudo nano /etc/thinkbook-eink/secrets.env
#
# The systemd unit loads this file via EnvironmentFile= before starting
# eink-server. All keys are optional — anything left unset here can still
# be set in server.toml instead (server.toml wins if both are set), but
# keeping credentials only here keeps them out of the more widely-readable
# config file.
#
# Plain KEY=VALUE, no quotes needed around values.

NEXTCLOUD_USER=admin
NEXTCLOUD_PASSWORD=your-password-here
NEXTCLOUD_TOKEN=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

COUCHDB_USER=admin
COUCHDB_PASSWORD=your-couchdb-password

FIREFLY_TOKEN=your-firefly-personal-access-token

GRAMPS_USER=admin
GRAMPS_PASSWORD=your-gramps-password
